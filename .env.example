# ==============================================================================
# UNIVERSAL CHATBOT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. n8n Orchestrator Settings
# ------------------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# 2. LLM / Gemini Credentials & Key Rotation Pool (Multi-Key Anti-Kehabisan Token)
# ------------------------------------------------------------------------------
# Dapatkan Gemini API Key gratis di: https://aistudio.google.com/
# Anda bisa memasukkan 1 key, atau banyak key dipisahkan koma untuk rotasi otomatis!
# Setiap key melipatgandakan kuota (+15 RPM, +1.500 requests/hari, +1M token).
# Contoh: GEMINI_API_KEYS=AIzaSyA...,AIzaSyB...,AIzaSyC...
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. Fitur Tracking & Sisa Token (Terpisah / Isolated)
# ------------------------------------------------------------------------------
# Batas kuota token bulanan untuk estimasi sisa token (default 1.000.000 token).
# Set 0 untuk unlimited / pay-as-you-go.
GEMINI_MONTHLY_TOKEN_QUOTA=1000000
GEMINI_TOKEN_WARNING_PERCENT=85

# ------------------------------------------------------------------------------
# 4. Isolasi Database (Zero Disruption to Production DB)
# ------------------------------------------------------------------------------
# Nama koneksi database khusus untuk chatbot.
# Kosongkan untuk menggunakan koneksi default aplikasi, atau isi dengan 'sqlite'
# untuk menyimpan riwayat chat & token di file SQLite terpisah (100% aman dari DB utama).
DB_CHATBOT_CONNECTION=
CHATBOT_TABLE_MESSAGES=chatbot_conversation_messages
CHATBOT_TABLE_TOKENS=chatbot_token_usages
CHATBOT_TABLE_TICKETS=chatbot_tickets

# ------------------------------------------------------------------------------
# 5. Backend Integration & Security Settings
# ------------------------------------------------------------------------------
# Alamat backend Laravel Anda:
# - Jika Laravel berjalan native di Linux/Mac/Win: gunakan http://host.docker.internal:8000
# - Jika Laravel berjalan di Docker network yang sama: gunakan http://app:8000
BACKEND_BASE_URL=http://host.docker.internal:8000

# Kunci API internal untuk otentikasi request n8n ke backend
INTERNAL_API_KEY=your_secure_internal_api_key_here
CHATBOT_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 6. Notifikasi Tiket Masalah Pelanggan (Slack, Telegram & WhatsApp)
# ------------------------------------------------------------------------------
# Opsi 1: Slack Channel (REKOMENDASI: Sangat tertata dengan Block Kit & Thread Diskusi)
# Buat incoming webhook di: https://api.slack.com/apps -> Incoming Webhooks
SLACK_NOTIFICATIONS_ENABLED=true
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#customer-tickets

# Opsi 2: Telegram Bot (Opsional)
# Dapatkan bot token gratis di Telegram via @BotFather dan chat_id via @userinfobot
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opsi 3: WhatsApp Gateway (Opsional: via Gateway Wablas, Fonnte, Twilio, atau Webhook)
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_TARGET_NUMBER=

# Opsi 4: WhatsApp Chatbot Khusus Eksekutif (Executive AI Assistant)
# Akses terproteksi whitelist untuk jajaran Direksi, C-Level, & Manajer
WHATSAPP_EXECUTIVE_ENABLED=true
WHATSAPP_PROVIDER=fonnte
WHATSAPP_EXECUTIVE_REQUIRE_WHITELIST=true
# Daftar nomor WA eksekutif yang diizinkan (pisahkan koma)
WHATSAPP_EXECUTIVE_WHITELIST=08123456789,08198765432
# Pemetaan nomor ke nama & jabatan (opsional)
WHATSAPP_EXECUTIVE_DIRECTORY=08123456789:Budi Santoso (Direktur Utama),08198765432:Siti Rahma (CFO)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=chatbot_secret_token

# ------------------------------------------------------------------------------
# 7. Integrasi Jira Service Management / Jira Service Desk (Atlassian)
# ------------------------------------------------------------------------------
# Setiap keluhan pelanggan yang dilaporkan ke chatbot otomatis menerbitkan
# tiket resmi di Jira Service Desk (Proyek SUP).
# URL: https://imtekservice.atlassian.net/jira/servicedesk/projects/SUP
JIRA_ENABLED=true
JIRA_HOST=imtekservice.atlassian.net
JIRA_PROJECT_KEY=SUP
# Email akun Atlassian Anda yang memiliki akses ke proyek SUP
JIRA_USER_EMAIL=
# Dapatkan Atlassian API Token gratis di:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Tipe issue default (misal: 'Service Request', 'Task', 'Bug', 'IT Help')
JIRA_ISSUE_TYPE=Service Request
