# ==============================================================================
# UNIVERSAL CHATBOT CONFIGURATION (.env)
# ==============================================================================

# n8n Orchestrator Settings
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Jakarta

# LLM / AI Credentials
# Dapatkan Gemini API Key melalui https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Integration Settings
# Alamat aplikasi Laravel / backend Anda (gunakan host.docker.internal jika berjalan di host lokal)
BACKEND_BASE_URL=http://host.docker.internal:8000

# Kunci API internal untuk otentikasi request n8n ke backend
INTERNAL_API_KEY=your_secure_internal_api_key_here
